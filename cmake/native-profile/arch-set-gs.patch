+ptr_int_t
+tls_handle_set_gs(dcontext_t *dcontext, reg_t base)
+{
+    os_local_state_t *os_tls = get_os_tls();
+    os_thread_data_t *ostd = dcontext->os_field;
+    our_modify_ldt_t *desc = ostd->app_thread_areas;
+    ptr_int_t result = dynamorio_syscall(SYS_arch_prctl, 2, ARCH_SET_GS, base);
+    if (result < 0)
+        return result;
+    /* The cache-return sequence reads DR's dcontext through GS.  Execute the
+     * kernel operation here and restore DR's segment before returning to it.
+     * Keep the actual selector and thread area produced by the kernel. */
+    if (TLS_REG_LIB == SEG_GS) {
+        os_tls->app_lib_tls_reg = read_thread_register(SEG_GS);
+        os_tls->app_lib_tls_base = (void *)base;
+    } else {
+        os_tls->app_alt_tls_reg = read_thread_register(SEG_GS);
+        os_tls->app_alt_tls_base = (void *)base;
+    }
+    desc[GS_TLS].entry_number = tls_min_index() + GS_TLS;
+    dynamorio_syscall(SYS_get_thread_area, 1, &desc[GS_TLS]);
+    os_set_dr_seg(dcontext, SEG_GS);
+    return result;
+}
